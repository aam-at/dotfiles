// Custom layout overrides.
// dms/layout.kdl is auto-generated by DMS (theme sync) and gets overwritten
// on every DMS restart — hand-edited layout settings live here instead,
// included right after it so they apply on top.

layout {
    // Mod+R cycle matches the manual presets on Mod+Ctrl+1-4 (33/50/67/100%).
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // Single window on a column centers itself instead of sitting pinned
    // to the left edge.
    always-center-single-column
}
