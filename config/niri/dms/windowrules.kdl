// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^org\\.gnome\\."
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^microsoft-edge"
    match app-id="^google-chrome"
    match app-id="^emacs(client)?$"
    match app-id="^dev\\.zed\\.Zed"
    match app-id="^code(-url-handler)?$"
    match app-id="^antigravity"
    match app-id="^jetbrains-pycharm"
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="^gnome-control-center$"
    match app-id="^nm-connection-editor$"
    open-floating false
    default-column-width { proportion 0.5; }
}

// @id=dms_rule_5 @name=
window-rule {
    match app-id="^gnome-calculator$"
    match app-id="^galculator$"
    match app-id="^blueman-manager$"
    match app-id="^org\\.gnome\\.Nautilus$"
    match app-id="^xdg-desktop-portal$"
    match app-id="^zoom$"
    open-floating true
}

// @id=dms_rule_6 @name=
window-rule {
    match app-id="guifetch"
    match app-id="yad"
    match app-id="zenity"
    match app-id="wev"
    match app-id="^org\\.gnome\\.FileRoller$"
    match app-id="file-roller"
    match app-id="^com\\.github\\.GradienceTeam\\.Gradience$"
    match app-id="feh"
    match app-id="imv"
    match app-id="system-config-printer"
    match app-id="^nwg-look$"
    open-floating true
}

// @id=dms_rule_7 @name=
window-rule {
    match app-id="org\\.quickshell$"
    open-floating true
}

// @id=dms_rule_8 @name=
window-rule {
    match app-id="^org\\.gnome\\.Settings$"
    open-floating true
}

// @id=dms_rule_9 @name=
window-rule {
    match app-id="^pavucontrol$"
    match app-id="^org\\.pulseaudio\\.pavucontrol$"
    match app-id="yad-icon-browser"
    open-floating true
}

// @id=dms_rule_10 @name=
window-rule {
    match title="^(Select|Open)( a)? (File|Folder)(s)?$"
    open-floating true
}

// @id=dms_rule_11 @name=
window-rule {
    match title="^File (Operation|Upload)( Progress)?$"
    open-floating true
}

// @id=dms_rule_12 @name=
window-rule {
    match title=".* Properties$"
    open-floating true
}

// @id=dms_rule_13 @name=
window-rule {
    match title="Export Image as PNG"
    match title="GIMP Crash Debug"
    match title="Save As"
    match title="Library"
    open-floating true
}

// @id=dms_rule_14 @name=
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    match title="Picture(-| )in(-| )[Pp]icture"
    open-floating true
}

// @id=dms_rule_15 @name=
window-rule {
    match app-id="^steam$" title="^notificationtoasts_\\d+_desktop$"
    open-focused false
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// @id=dms_rule_16 @name=
window-rule {
    match app-id="steam"
    geometry-corner-radius 10
}

// @id=dms_rule_17 @name=
window-rule {
    match app-id="steam" title="Friends List"
    open-floating true
}

// @id=dms_rule_18 @name=
window-rule {
    match app-id="^com-atlauncher-App$" title="ATLauncher Console"
    open-floating true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
