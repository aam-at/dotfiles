// Niri configuration
// KDL format: https://kdl.dev
// Wiki: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
//
// Shared compositor settings live in dms/ for compatibility with DMS.
// The active desktop shell is selected through shells/active.kdl.

// Core settings
include "dms/misc.kdl"
include "dms/input.kdl"
include "dms/environment.kdl"

// Behavior
include "dms/windowrules.kdl"
include "dms/workspaces.kdl"

// Hardware
include "dms/outputs.kdl"

// The generated local selector defaults to Noctalia; switch it with desktop-shell.
include "shells/active.kdl"

// Load the active generated theme after shell and DMS configuration.
include "../theme/niri.kdl"
