[Unit]
Description=HerdR headless server
Documentation=https://herdr.dev
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.bash_env
ExecStart=%h/.cargo/bin/herdr server
ExecStop=%h/.cargo/bin/herdr server stop
KillMode=mixed
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
