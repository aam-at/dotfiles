{
    "plugins": {
        "@textlint/text": {
            "extensions": [".org"]
        }
    },
    "rules": {
        "write-good": {
            "eprime": true
        },
        "no-start-duplicated-conjunction": true,
        "max-comma": {
            "max": 4
        },
        "terminology": true,
        "abbr-within-parentheses": true,
        "alex": true,
        "apostrophe": true,
        "common-misspellings": true,
        "date-weekday-mismatch": true,
        "en-max-word-count": {
            "max": 35
        },
        "diacritics": true,
        "stop-words": true,
        "unexpanded-acronym": true
    }
}
