[include]
    path = aliases.gitconfig
    path = themes.gitconfig
    path = ~/.config/theme/delta.gitconfig
[core]
    editor = /usr/bin/nvim
    filemode = false
    autocrlf = input
    pager = delta
    fsmonitor = true
[feature]
    manyFiles = true
[interactive]
    diffFilter = delta --color-only
[diff]
    tool = kitty
    guitool = kitty.gui
[delta]
    features = gruvbox-dark
    navigate = true
    side-by-side = true
[merge]
    conflictstyle = zdiff3
[rerere]
    enabled = true
[difftool]
    prompt = false
    trustExitCode = true
[difftool "kitty"]
    cmd = kitten diff $LOCAL $REMOTE
[difftool "kitty.gui"]
    cmd = kitten diff $LOCAL $REMOTE
[user]
    email = alexander.matyasko@gmail.com
    name = Alexander Matyasko
[diff "gpg"]
	textconv = gpg --no-tty --decrypt
	cachetextconv = true
	binary = true
[diff "pdf"]
    textconv = sh -c 'pdftotext -layout -enc UTF-8 "$0" -'
[push]
	default = simple
	autoSetupRemote = true
[github]
	user = alexander.matyasko@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[credential]
	helper = store
