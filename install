#!/usr/bin/env bash

set -uo pipefail

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTBOT="${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}"

failures=()
failure_outputs=()

run_step() {
    local label="$1"
    local output
    shift

    if output="$("$@" 2>&1)"; then
        [[ -z "${output}" ]] || printf '%s\n' "${output}"
    else
        failures+=("${label}")
        failure_outputs+=("${output}")
    fi
}

cd "${BASEDIR}" || exit 1
echo "==> Initializing ${DOTBOT_DIR}"
run_step "Initialize ${DOTBOT_DIR}" git submodule update --init --recursive "${DOTBOT_DIR}"

configs=()

# Keep the repository-level manifest first, then run component manifests in a
# stable order. Each manifest is executed relative to its own directory so
# component configs can use local paths.
if [[ -f "${BASEDIR}/install.conf.yaml" ]]; then
    configs+=("${BASEDIR}/install.conf.yaml")
fi

while IFS= read -r -d '' config; do
    [[ "${config}" == "${BASEDIR}/install.conf.yaml" ]] && continue
    configs+=("${config}")
done < <(
    find "${BASEDIR}" \
        \( -path "${BASEDIR}/.git" -o -path "${BASEDIR}/${DOTBOT_DIR}" \) -prune -o \
        -type f -name install.conf.yaml -print0 | sort -z
)

if [[ ${#configs[@]} -eq 0 ]]; then
    echo "No install.conf.yaml files found under ${BASEDIR}" >&2
    exit 1
fi

if [[ -x "${DOTBOT}" ]]; then
    for config in "${configs[@]}"; do
        config_dir="$(dirname "${config}")"
        relative_config="${config#"${BASEDIR}/"}"

        echo "==> Running ${relative_config}"
        run_step "${relative_config}" "${DOTBOT}" --force-color -d "${config_dir}" -c "${config}" "${@}"
    done
else
    failures+=("Run Dotbot manifests")
    failure_outputs+=("Dotbot executable not found: ${DOTBOT}")
fi

if ((${#failures[@]})); then
    printf '\n==> Installation finished with %d failure(s):\n' "${#failures[@]}" >&2
    for index in "${!failures[@]}"; do
        printf '\n--- %s ---\n%s\n' "${failures[index]}" "${failure_outputs[index]}" >&2
    done
    exit 1
fi
