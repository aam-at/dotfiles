#!/usr/bin/env bash
# Install the version-controlled greetd configuration without restarting greetd
# (restarting it can terminate the currently active graphical session).
set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
repo_dir="$(cd "$(dirname "$script_path")/.." && pwd)"
source_file="$repo_dir/config/greetd/config.toml"
target_file="/etc/greetd/config.toml"
backup_file="/etc/greetd/config.toml.before-session-menu.$(date +%Y%m%d%H%M%S)"

[[ -f "$source_file" ]] || {
  echo "Cannot find $source_file" >&2
  exit 1
}

if ! command -v tuigreet >/dev/null; then
  sudo pacman -S --needed greetd-tuigreet
fi

if [[ -f "$target_file" ]]; then
  sudo cp --preserve=mode,ownership,timestamps "$target_file" "$backup_file"
  echo "Backed up the current configuration to $backup_file"
fi

sudo install -D -m 0644 "$source_file" "$target_file"

# Keep the current graphical session alive, but ensure the next boot starts
# greetd instead of the display manager that currently owns the alias.
for display_manager in sddm gdm lightdm; do
  if systemctl is-enabled --quiet "$display_manager.service"; then
    sudo systemctl disable "$display_manager.service"
    echo "Disabled $display_manager.service for future boots"
  fi
done
sudo systemctl enable greetd.service

cat <<'EOF'
Installed the greetd session chooser.

Reboot before logging out. This is intentional: restarting greetd from an
active session can terminate it. At the next login screen, press F3 to select
COSMIC, Niri, Hyprland, or Hyprland (uwsm-managed).
EOF
